{
  "name": "@qint/node",
  "version": "0.2.0",
  "description": "Official Node.js / TypeScript SDK for the Qint public merchant API — a typed client plus webhook helpers.",
  "keywords": [
    "qint",
    "payments",
    "crypto",
    "checkout",
    "webhooks",
    "sdk",
    "typescript"
  ],
  "license": "MIT",
  "author": "SwizzX GmbH",
  "homepage": "https://docs.qint.ch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SwizzX-GmbH/qint-node.git"
  },
  "bugs": {
    "url": "https://github.com/SwizzX-GmbH/qint-node/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
